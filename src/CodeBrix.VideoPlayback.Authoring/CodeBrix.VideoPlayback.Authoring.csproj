<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.VideoPlayback.Authoring</AssemblyName>
    <RootNamespace>CodeBrix.VideoPlayback.Authoring</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.VideoPlayback.Authoring.MitLicenseForever</PackageId>
    <Product>CodeBrix.VideoPlayback.Authoring</Product>
    <Title>CodeBrix.VideoPlayback.Authoring</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A developer tool for preparing video files for playback in your app - not something you ship inside it. Converts a source video into a compact, efficient format, with options for captions, chapters, and color adjustments. Includes a dry-run mode that shows exactly what it would do before it does anything.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.VideoPlayback</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.VideoPlayback</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>video;authoring;encoding;ffmpeg;av1;webm;cbv;opus;vorbis;webvtt;lut;CodeBrix</PackageTags>
  </PropertyGroup>

  <!--
    Every package reference here is there for WRITING, never for playing.
    CodeBrix.VideoProcessing builds and launches the ffmpeg command lines of the WebM-profile and bespoke
    flavours, and is the desktop engine the in-process passes fall back to when the application registered
    none. CodeBrix.VideoProcessing.Core is the engine-neutral contract the in-process passes decode their
    source through - any registered engine, so they do not depend on ffmpeg. The in-process passes ENCODE IN
    PROCESS: CodeBrix.VideoEncoding.Av1 writes the picture and the master flavour's monochrome alpha plane,
    CodeBrix.Audio.FlacWriter the master flavour's lossless sound as FLAC packets, CodeBrix.Audio.Vorbis
    the bespoke flavour's sound when that flavour is encoded in process (and Vorbis in a Matroska document),
    and CodeBrix.Audio.Opus - for its ENCODER only - the WebM-profile flavour's Opus sound when that flavour is
    encoded in process. The core (below) supplies the bespoke muxer, the managed WebM / Matroska muxer, the
    caption and chapter readers, the LUT composer and the streamable-profile rules. NEVER a decoder, never
    SkiaSharp, never the .Skia presenter, never an Android-only package, and never a Register() call into a
    playback registry: authoring writes files, it does not play them or draw them.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" Version="1.0.284.20" />
    <PackageReference Include="CodeBrix.VideoProcessing.Core.MitLicenseForever" Version="1.0.284.20" />
    <PackageReference Include="CodeBrix.VideoEncoding.Av1.BsdLicenseForever" Version="1.0.284.321" />
    <PackageReference Include="CodeBrix.Audio.FlacWriter.BsdLicenseForever" Version="1.0.284.304" />
    <PackageReference Include="CodeBrix.Audio.Vorbis.BsdLicenseForever" Version="1.0.283.1118" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.283.1405" />
  </ItemGroup>

  <!--
    The core is referenced as a project here and packs as a package DEPENDENCY, not as a bundled assembly -
    all three projects carry the same date-stamped version block, so one pack run stamps them with one
    version and this package depends on the core at exactly that number.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeBrix.VideoPlayback\CodeBrix.VideoPlayback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="AGENT-README.txt" Pack="true" PackagePath="AGENT-README.txt" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
