<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
    <!--
      The TEST project may reference the Opus package - it proves the Opus path works once an
      application registers it. The LIBRARY never does; see MAINTAINER-README.txt.
    -->
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.271.1185" />
    <!--
      The TEST project references the full audio package because the opt-in tests that open the audio
      device need its native engine. The LIBRARY references only CodeBrix.Audio.Core, which ships no
      native, and must keep it that way; see MAINTAINER-README.txt.
    -->
    <PackageReference Include="CodeBrix.Audio.MitLicenseForever" Version="1.0.271.1165" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.VideoPlayback\CodeBrix.VideoPlayback.csproj" />
  </ItemGroup>

  <!--
    Golden container assets live under tests/assets and are copied next to the test assembly.
    They are generated locally by tests/assets/generate-assets.sh from FFmpeg's synthetic lavfi
    sources - see tests/assets/ASSETS.txt - never third-party media.
  -->
  <ItemGroup>
    <Content Include="..\assets\*.webm;..\assets\*.mkv;..\assets\*.cbv;..\assets\*.cbvmaster;..\assets\*.json;..\assets\*.vtt;..\assets\*.srt;..\assets\*.ffmeta;..\assets\*.ivf;..\assets\*.ogg;..\assets\*.opus;..\assets\*.txt">
      <Link>assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
