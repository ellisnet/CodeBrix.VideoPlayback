<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
    <!--
      THE TEST PROJECT may reference the decoder and the Opus package, because it PLAYS what the authoring
      library writes: an authored file that no decoder can open has not been proved to be a video. The
      AUTHORING LIBRARY references neither, and never will - it writes files, it does not play them.
      See MAINTAINER-README.txt.
    -->
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.242.1054" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.245.260" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.VideoPlayback.Authoring\CodeBrix.VideoPlayback.Authoring.csproj" />
    <!--
      The corpus generator is referenced so that ONE test can prove the library renders exactly the command
      lines the committed manifest records. That is what lets the eighteen files already in the repository
      stand unregenerated: the plan they came from still produces the same commands.
    -->
    <ProjectReference Include="..\..\tools\CodeBrix.VideoPlayback.AssetAuthoring\CodeBrix.VideoPlayback.AssetAuthoring.csproj" />
  </ItemGroup>

  <!--
    The caption, chapter and lookup-table inputs the end-to-end tests author with. The MEDIA is not copied:
    every clip these tests use is generated on the spot from FFmpeg's own synthetic sources, so nothing here
    depends on a corpus having been built.
  -->
  <ItemGroup>
    <Content Include="..\assets\*.vtt;..\assets\*.srt;..\assets\*.ffmeta">
      <Link>assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\LUTs\generated\*.cube">
      <Link>assets\LUTs\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
