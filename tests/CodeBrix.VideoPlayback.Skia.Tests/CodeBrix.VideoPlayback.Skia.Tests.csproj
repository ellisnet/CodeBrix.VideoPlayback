<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
    <!--
      The TEST project supplies Skia's native binary for this machine; the LIBRARY never does, because the
      application picks the native asset package that suits the platform it ships on. See MAINTAINER-README.txt.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.VideoPlayback.Skia\CodeBrix.VideoPlayback.Skia.csproj" />
  </ItemGroup>

  <!--
    The steady-state allocation helper is LINKED from the core test project for the same reason: one copy of
    the reasoning about why an "allocates nothing" assertion has to be measured more than once. So are the
    two hand-built grading tables, so that the effect tests in the core suite and the presenter tests here
    grade with one definition of "invert" and one of "halve".
  -->
  <ItemGroup>
    <Compile Include="..\CodeBrix.VideoPlayback.Tests\SteadyStateAllocation.cs" Link="SteadyStateAllocation.cs" />
    <Compile Include="..\CodeBrix.VideoPlayback.Tests\TestLuts.cs" Link="TestLuts.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\*.cbv;..\assets\*.txt">
      <Link>assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
