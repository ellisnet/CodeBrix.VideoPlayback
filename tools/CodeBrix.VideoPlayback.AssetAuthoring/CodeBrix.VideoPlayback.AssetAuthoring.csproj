<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.VideoPlayback.AssetAuthoring</AssemblyName>
    <RootNamespace>CodeBrix.VideoPlayback.AssetAuthoring</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The ONLY dependency is the CodeBrix video-processing wrapper. This tool never launches ffmpeg itself:
    every command line below is built with that library's argument model and run through its process host,
    which is the point - the tool is the working prototype of the authoring helper the library side of this
    program will eventually expose, so the command construction has to be exercised, not imitated.

    It deliberately does NOT reference CodeBrix.VideoPlayback: the corpus is verified by the repository's own
    reader through the TEST project (tests/CodeBrix.VideoPlayback.Tests/AuthoringCorpusTests.cs) and through
    the cbvinfo verb, so this generator stays a pure producer with nothing of the library under test in it.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" Version="1.0.241.68" />
  </ItemGroup>

</Project>
