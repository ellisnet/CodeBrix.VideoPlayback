<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.VideoPlayback.AssetAuthoring</AssemblyName>
    <RootNamespace>CodeBrix.VideoPlayback.AssetAuthoring</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Every command line this tool runs is built by CodeBrix.VideoPlayback.Authoring, which is the authoring
    helper this tool used to be a prototype of. That reference brings the playback core in with it, and it
    has to: the CodeBrix-Mode2 files are written by the core's own bespoke muxer, and the streamable-profile
    rules the tool judges every finished file with are the core's too.

    The video-processing wrapper stays a DIRECT reference because this tool uses it directly as well -
    FFProbe.Analyse reads the two originals and reads every FFmpeg-muxed output back, which is what makes the
    corpus judged by an implementation other than the one that wrote it.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoProcessing.MitLicenseForever" Version="1.0.241.68" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.VideoPlayback.Authoring\CodeBrix.VideoPlayback.Authoring.csproj" />
  </ItemGroup>

</Project>
