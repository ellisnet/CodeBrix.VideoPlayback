<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.VideoPlayback.Tools</AssemblyName>
    <RootNamespace>CodeBrix.VideoPlayback.Tools</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The uncompressed-video decoder needs nothing here any more: it ships in the playback library itself and
    registers itself, so cbvdecode decodes a raw-codec file through the ordinary decoder registry with no
    codec package installed and no linked source.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.VideoPlayback\CodeBrix.VideoPlayback.csproj" />
  </ItemGroup>

</Project>
