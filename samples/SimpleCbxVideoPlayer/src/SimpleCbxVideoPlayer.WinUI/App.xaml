<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SimpleCbxVideoPlayer.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SimpleCbxVideoPlayer.WinUI"
    RequestedTheme="Dark">
    <!--
        Dark on purpose, not by preference: the lookup-table panel is painted with fixed dark colours,
        as it is on the CodeBrix.Platform head, and light-theme text over them would be unreadable.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
