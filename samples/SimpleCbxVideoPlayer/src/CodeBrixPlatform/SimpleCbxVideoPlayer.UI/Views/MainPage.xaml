<Page
    x:Class="SimpleCbxVideoPlayer.Views.MainPage"
    xmlns="clr-namespace:Microsoft.UI.Xaml.Controls;assembly=CodeBrix.Platform.UI"
    xmlns:d="clr-namespace:Microsoft.UI.Xaml.Data;assembly=CodeBrix.Platform.UI"
    xmlns:m="clr-namespace:Microsoft.UI.Xaml.Media;assembly=CodeBrix.Platform.UI"
    xmlns:ui="clr-namespace:Microsoft.UI.Xaml;assembly=CodeBrix.Platform.UI"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Windows;assembly=CodeBrix.Platform.SkiaSharp.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:SimpleCbxVideoPlayer.ViewModels;assembly=SimpleCbxVideoPlayer.Core"
    xmlns:local="using:SimpleCbxVideoPlayer.Views"
    FontFamily="{StaticResource RobotoFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Page.Resources>
        <m:SolidColorBrush x:Key="PanelBrush" Color="#1C1F26" />
        <m:SolidColorBrush x:Key="HairlineBrush" Color="#333944" />
        <m:SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA3B2" />
        <m:SolidColorBrush x:Key="MessageBrush" Color="#F2B155" />

        <!-- One lookup table: its tick box, its title, where it came from and how much of it to apply -->
        <ui:DataTemplate x:Key="LutRowTemplate">
            <Grid Padding="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          MinWidth="32"
                          IsChecked="{d:Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{d:Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{d:Binding SubtitleText}" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBox Text="{d:Binding PercentText, Mode=TwoWay}" Width="54" FontSize="13"
                             TextAlignment="Right" />
                    <TextBlock Text="%" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ui:DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The two drop-downs: what to play, and how to compose it -->
        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Video" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                <ComboBox Width="330"
                          ItemsSource="{d:Binding Videos}"
                          SelectedItem="{d:Binding SelectedVideo, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          PlaceholderText="No videos found" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Render path" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
                <ComboBox Width="230"
                          ItemsSource="{d:Binding RenderPathChoices}"
                          SelectedItem="{d:Binding SelectedRenderPath, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Bottom">
                <TextBlock Text="{d:Binding RenderPathText}" FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- The picture, and the lookup-table panel beside it -->
        <Grid Grid.Row="1" Padding="16,4,16,4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- The canvases live here: the GPU one is added by the page when the graphics device starts -->
            <Border Grid.Column="0" Background="Black" BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="4">
                <Grid x:Name="VideoHost" Background="Black">
                    <skia:SKXamlCanvas x:Name="CpuCanvas" PaintSurface="OnCpuPaintSurface" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4">
                <Grid Padding="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Colour lookup tables" FontSize="14" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Text="{d:Binding LutSummaryText}" FontSize="11" Margin="0,2,0,6"
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Text="{d:Binding LutPanelNote}"
                               Visibility="{d:Binding LutPanelNoteVisibility}"
                               FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{StaticResource MessageBrush}" />

                    <ScrollViewer Grid.Row="3" IsEnabled="{d:Binding IsLutPanelEnabled}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{d:Binding Luts}"
                                      ItemTemplate="{StaticResource LutRowTemplate}" />
                    </ScrollViewer>

                    <!-- Bakes what is ON SCREEN: the chain applied at the last Play, as one .cube file -->
                    <StackPanel Grid.Row="4" Spacing="6" Margin="0,10,0,0">
                        <Button Content="Bake chain to .cube" HorizontalAlignment="Stretch"
                                Command="{d:Binding BakeCommand}" />
                        <TextBlock Text="{d:Binding BakeStatusText}"
                                   Visibility="{d:Binding BakeStatusVisibility}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Transport: the three buttons, the scrub bar and the clock -->
        <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Play" Width="82" Command="{d:Binding PlayCommand}" />
            <Button Grid.Column="1" Content="Pause" Width="82" Command="{d:Binding PauseCommand}" />
            <Button Grid.Column="2" Content="Stop" Width="82" Command="{d:Binding StopCommand}" />

            <Slider Grid.Column="3" Minimum="0" StepFrequency="0.05"
                    Maximum="{d:Binding DurationSeconds}"
                    Value="{d:Binding PositionSeconds, Mode=TwoWay}"
                    VerticalAlignment="Center" />

            <TextBlock Grid.Column="4" Text="{d:Binding TimeText}" FontSize="13" VerticalAlignment="Center"
                       MinWidth="96" TextAlignment="Right" />
        </Grid>

        <!-- Where the corpus came from, and anything the video libraries had to say, word for word -->
        <StackPanel Grid.Row="3" Padding="16,0,16,12" Spacing="4">
            <TextBlock Text="{d:Binding CorpusText}" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{d:Binding MessageText}" Visibility="{d:Binding MessageVisibility}"
                       FontSize="12" Foreground="{StaticResource MessageBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
