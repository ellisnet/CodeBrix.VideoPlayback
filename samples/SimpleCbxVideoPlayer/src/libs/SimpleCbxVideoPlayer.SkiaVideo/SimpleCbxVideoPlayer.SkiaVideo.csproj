<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- This is the one library in the sample with a public API, so its members carry XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.MitLicenseForever" Version="1.0.241.1343" />
    <PackageReference Include="CodeBrix.VideoPlayback.Skia.MitLicenseForever" Version="1.0.241.1343" />
  </ItemGroup>

  <!--
    The AV1 decoder and the Opus audio decoder, both registered once in SkiaVideoRuntime.Initialize().
    Without the first, "av01" has no decoder and nothing plays; without the second, the Opus soundtrack
    every file in the corpus carries has none either.

    Both packages below are the published nuget.org versions.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.241.1363" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.241.1040" />
  </ItemGroup>
</Project>
