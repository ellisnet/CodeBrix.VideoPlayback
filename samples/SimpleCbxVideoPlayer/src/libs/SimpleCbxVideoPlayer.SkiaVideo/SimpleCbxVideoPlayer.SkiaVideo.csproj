<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- This is the one library in the sample with a public API, so its members carry XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.MitLicenseForever" Version="1.0.280.1149" />
    <PackageReference Include="CodeBrix.VideoPlayback.Skia.MitLicenseForever" Version="1.0.280.1149" />
  </ItemGroup>

  <!--
    The AV1 decoder and the Opus audio decoder, both registered once in SkiaVideoRuntime.Initialize().
    Without the first, "av01" has no decoder and nothing plays; without the second, the Opus soundtrack
    every file in the corpus carries has none either.

    Both packages below are the published nuget.org versions.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.VideoPlayback.Dav1d.BsdLicenseForever" Version="1.0.271.1206" />
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.284.1151" />
  </ItemGroup>

  <!--
    The desktop audio natives (miniaudio). CodeBrix.VideoPlayback.Skia references only CodeBrix.Audio.Core, so
    the application chooses its audio engine: CodeBrix.Audio on Windows/Linux/macOS (this sample), the Android
    audio package on Android. Without it the sample plays its picture in silence.
  -->
  <ItemGroup>
    <PackageReference Include="CodeBrix.Audio.MitLicenseForever" Version="1.0.283.1382" />
  </ItemGroup>
</Project>
