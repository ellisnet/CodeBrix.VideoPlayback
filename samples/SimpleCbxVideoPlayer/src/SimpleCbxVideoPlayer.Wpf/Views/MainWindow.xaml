<Window x:Class="SimpleCbxVideoPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimpleCbxVideoPlayer.ViewModels"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="SimpleCbxVideoPlayer" Height="760" Width="1180"
        Background="{StaticResource PageBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The two drop-downs: what to play, and how to compose it -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Video" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource SubtleTextBrush}" />
                <ComboBox Width="330"
                          ItemsSource="{Binding Videos}"
                          SelectedItem="{Binding SelectedVideo, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="Render path" FontSize="12" Margin="0,0,0,4"
                           Foreground="{StaticResource SubtleTextBrush}" />
                <ComboBox Width="230"
                          ItemsSource="{Binding RenderPathChoices}"
                          SelectedItem="{Binding SelectedRenderPath, Mode=TwoWay}"
                          DisplayMemberPath="Label" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding RenderPathText}" FontSize="12"
                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- The picture, and the lookup-table panel beside it -->
        <Grid Grid.Row="1" Margin="16,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- The canvases live here: the GPU one is added by the window when OpenGL starts -->
            <Border Grid.Column="0" Margin="0,0,16,0" Background="Black"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4">
                <Grid x:Name="VideoHost" Background="Black">
                    <skia:SKElement x:Name="CpuCanvas" PaintSurface="OnCpuPaintSurface" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Colour lookup tables" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />

                    <TextBlock Grid.Row="1" Text="{Binding LutSummaryText}" FontSize="11" Margin="0,2,0,6"
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Text="{Binding LutPanelNote}"
                               Visibility="{Binding LutPanelNoteVisibility}"
                               FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                               Foreground="{StaticResource MessageBrush}" />

                    <ScrollViewer Grid.Row="3" IsEnabled="{Binding IsLutPanelEnabled}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Luts}"
                                      ItemTemplate="{StaticResource LutRowTemplate}" />
                    </ScrollViewer>

                    <!-- Bakes what is ON SCREEN: the chain applied at the last Play, as one .cube file -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button Content="Bake chain to .cube" HorizontalAlignment="Stretch" Padding="8,4"
                                Command="{Binding BakeCommand}" />
                        <TextBlock Text="{Binding BakeStatusText}"
                                   Visibility="{Binding BakeStatusVisibility}"
                                   FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Transport: the three buttons, the scrub bar and the clock -->
        <Grid Grid.Row="2" Margin="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Play" Width="82" Padding="8,4" Margin="0,0,10,0"
                    Command="{Binding PlayCommand}" />
            <Button Grid.Column="1" Content="Pause" Width="82" Padding="8,4" Margin="0,0,10,0"
                    Command="{Binding PauseCommand}" />
            <Button Grid.Column="2" Content="Stop" Width="82" Padding="8,4" Margin="0,0,10,0"
                    Command="{Binding StopCommand}" />

            <!-- WPF's Slider has no StepFrequency; SmallChange is the same 0.05-second nudge -->
            <Slider Grid.Column="3" Minimum="0" SmallChange="0.05" LargeChange="1"
                    Maximum="{Binding DurationSeconds}"
                    Value="{Binding PositionSeconds, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="0,0,10,0" />

            <TextBlock Grid.Column="4" Text="{Binding TimeText}" FontSize="13" VerticalAlignment="Center"
                       MinWidth="96" TextAlignment="Right" Foreground="{StaticResource TextBrush}" />
        </Grid>

        <!-- Where the corpus came from, and anything the video libraries had to say, word for word -->
        <StackPanel Grid.Row="3" Margin="16,0,16,12">
            <TextBlock Text="{Binding CorpusText}" FontSize="11"
                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding MessageText}" Visibility="{Binding MessageVisibility}"
                       FontSize="12" Margin="0,4,0,0"
                       Foreground="{StaticResource MessageBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
