<Application x:Class="SimpleCbxVideoPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>

        <!--
            The palette lives here rather than in the window because WPF resolves a StaticResource on the
            Window element itself before Window.Resources has been read; the application dictionary is the
            one place a window's own Background can reach.

            WPF has no light/dark theme of its own to inherit, so this head paints the same dark surface the
            CodeBrix.Platform head gets from ApplicationPageBackgroundThemeBrush, and the same four accents.
        -->
        <SolidColorBrush x:Key="PageBrush" Color="#12151B" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1C1F26" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#333944" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6E9EF" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#9AA3B2" />
        <SolidColorBrush x:Key="MessageBrush" Color="#F2B155" />

        <!--
            The light foreground is set on each TextBlock this application owns, NOT as an implicit
            Style TargetType="TextBlock". An implicit style reaches inside every control template too -
            the text a ComboBox shows for its selection, the label a Button makes from a string - and
            painted those light on their own light chrome, which is a washed-out window rather than a
            dark one.
        -->

        <!-- One lookup table: its tick box, its title, where it came from and how much of it to apply -->
        <DataTemplate x:Key="LutRowTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          MinWidth="32"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--
                        A percentage is committed when the box loses focus, which is WPF's own default for
                        TextBox.Text - so no UpdateSourceTrigger is named here on purpose.
                    -->
                    <TextBox Text="{Binding PercentText, Mode=TwoWay}" Width="54" FontSize="13"
                             TextAlignment="Right" Margin="0,0,4,0" />
                    <TextBlock Text="%" FontSize="13" Foreground="{StaticResource SubtleTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Application.Resources>
</Application>
